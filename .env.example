# XcavateProfile Configuration

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xcavate_profile
POSTGRES_USER=xcavate_user
POSTGRES_PASSWORD=xcavat...n
# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
# S3/Hetzner Object Storage
S3_ENDPOINT=https://fsn1.your-storagebox.de
S3_REGION=fsn1
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-s...n
# IPFS pinning of lawyer terms documents via Pinata; leave PINATA_JWT empty to disable
# (the upload endpoint answers 503). The gateway is where the pinned documents are read from.
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
# Admin Addresses (comma-separated; SS58 and/or Solana base58 are both accepted)
ADMIN_ADDRESSES=5GrwvaEF5zKbXCEe9qGjZL23Y641mot2Ff6hS3s8jF3g3k3W,DQJZmAVJZmN919gkbxREzb5iqoLZWLYx65Ts5JDnSb1b
# Push notifications via realXmarketNotificationsApi; leave the key empty to disable
NOTIFICATIONS_API_URL=https://notifications-api.xcavate.io
NOTIFICATIONS_API_KEY=
# Indexer GraphQL read endpoint — the voting webhooks resolve vote state (rounds, expiries,
# tallies, outcomes) from it before posting bucket announcements
INDEXER_GRAPHQL_URL=https://indexer-devnet.xcavate.io
# Shared secret gating the indexer webhooks: the notification webhooks (income_distributed /
# shares_received — the push fanout) and the bucket webhook offers_namespace_created_devnet
# (ADR-42). The indexer delivery loop cannot set headers, so the secret travels in the
# indexer-side route URL's ?secret= query parameter (e.g.
# https://<this-api>/webhooks/income_distributed_devnet?secret=<same value> and
# https://<this-api>/webhooks/offers_namespace_created_devnet?secret=<same value>). Leave EMPTY
# to keep those endpoints disabled (they answer 503).
INDEXER_WEBHOOK_SECRET=

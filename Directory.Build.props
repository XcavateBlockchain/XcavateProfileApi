<Project>

  <PropertyGroup>
    <!--
      Substrate.NET.API depends on StreamJsonRpc, which pulls in
      Microsoft.VisualStudio.Threading.Analyzers. No project here opted into the vs-threading
      rules, but they run anyway and produced 264 warnings across the solution:

        VSTHRD200 (258x) - "use an Async suffix" on NUnit test methods and GraphQL resolvers,
                           where the current names are deliberate. Renaming resolvers would
                           change the GraphQL schema, so the rule is actively wrong here.
        VSTHRD103 (6x)   - synchronous SQLite open/query in test setup, which is fine in tests.

      Silencing the two rule IDs is deliberate. Note that ExcludeAssets="analyzers" on a
      PackageReference does not work for this: it filters a single edge of the dependency graph,
      and these analyzers also arrive via StreamJsonRpc -> Microsoft.VisualStudio.Threading ->
      Microsoft.VisualStudio.Threading.Analyzers.
    -->
    <NoWarn>$(NoWarn);VSTHRD200;VSTHRD103</NoWarn>
  </PropertyGroup>

  <!--
    Shared NuGet metadata for the published client SDKs. Inert for the API and test projects,
    which are not packable. Package id, description and tags are per-project.
  -->
  <PropertyGroup>
    <Authors>Xcavate</Authors>
    <Company>Xcavate</Company>
    <Copyright>Copyright © Xcavate</Copyright>
    <PackageProjectUrl>https://github.com/Xcavate/XcavateProfile</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Xcavate/XcavateProfile</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Lets consumers step into the SDK from a stack trace without a local checkout. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

</Project>
